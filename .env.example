# ===========================================
# Fish Counter - Environment Configuration
# ===========================================
# Copy this file to .env and customize values
# ===========================================

# -----------------
# Flask App
# -----------------
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
FLASK_SECRET_KEY=change-this-to-a-secure-random-string

# -----------------
# Database
# -----------------
# SQLite (default):
# DATABASE_PATH=runtime/fish_counter.db
#
# MariaDB/MySQL:
DB_ENGINE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory
DB_USER=fishuser
DB_PASSWORD=your-strong-password

# -----------------
# Authentication / Email OTP
# -----------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=8
# SMTP settings for OTP emails (Gmail example):
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# -----------------
# Camera Settings
# -----------------
CAMERA_ID=0
CAMERA_FPS=60
CAMERA_FORCE_FPS_LOCK=false
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
FRAME_ROTATE=0

# -----------------
# USB Camera Settings (for USB webcams like EMEET C60E 4K)
# -----------------
# Enable USB camera optimizations (set false for CSI ribbon cameras)
USB_CAMERA_MODE=true
# OpenCV backend: v4l2 (recommended for Linux), auto, any
USB_CAMERA_BACKEND=v4l2
# Video codec: MJPG (recommended), YUYV, auto
USB_CAMERA_FOURCC=MJPG
# Buffer size: 1 = lowest latency (recommended for real-time counting)
USB_CAMERA_BUFFER_SIZE=1
# Enable autofocus (recommended for EMEET C60E)
USB_CAMERA_AUTOFOCUS=true
# Enable auto exposure
USB_CAMERA_AUTO_EXPOSURE=true

# -----------------
# Detection Settings
# -----------------
MODEL_PATH=models/fish_detector.onnx
MODEL_FALLBACK_PATH=models/fish_detector.pt
CONFIDENCE_THRESHOLD=0.25
TRACK_IOU_THRESHOLD=0.50
INPUT_SIZE=480
USE_GPU=false

# -----------------
# Display Settings
# -----------------
SHOW_PREVIEW_WINDOW=false
PREVIEW_SCALE=1.0
FPS_TARGET=60
FRAME_SKIP=2

# -----------------
# Counting Line
# -----------------
# Line position as % of frame height (58% = slightly below center)
# Higher value = lower on screen. Use -1 to use LINE_POSITION in pixels.
LINE_POSITION_PERCENT=58.0
LINE_POSITION=300
LINE_HYSTERESIS_PX=24
MIN_CROSSING_FRAMES=8
ROI_BAND_HEIGHT=200

# -----------------
# Frame Auto-fix (Blue cast / Sharpening)
# -----------------
ENABLE_FRAME_AUTOFIX=true
BLUE_CAST_FIX_ENABLE=true
BLUE_CAST_BRIGHTNESS_THRESHOLD=165.0
BLUE_CAST_RATIO_THRESHOLD=1.08
BLUE_CAST_MAX_REDUCTION=0.18
SHARPEN_STRENGTH=0.28
SHARPEN_SIGMA=1.2

# -----------------
# Device Identity
# -----------------
DEVICE_ID=your-device-id
DEVICE_TOKEN=your-device-token

# -----------------
# API Endpoints
# -----------------
INGEST_URL=http://127.0.0.1:5000/api/v1/ingest
LEGACY_UPDATE_COUNT_URL=http://127.0.0.1:5000/update_count

# -----------------
# Admin
# -----------------
ADMIN_API_KEY=

# -----------------
# Pricing (for inventory) — wholesale only, one flat price per fish
# -----------------
PRICE_PER_FISH=0.40

# -----------------
# CSP (Content Security Policy)
# -----------------
CSP_CDN_HOSTS=https://cdn.socket.io https://cdn.jsdelivr.net
